{
  "name": "king-fish-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sauvegarde": "node --env-file=.env.local scripts/sauvegarde.mjs",
    "restaurer": "node --env-file=.env.local scripts/restaurer.mjs",
    "excel:ventes": "node --env-file=.env.local scripts/generate-saisie-gerant-workbook.mjs --from-db",
    "excel:import": "node --env-file=.env.local scripts/import-ventes-jour-excel.mjs --dry-run",
    "excel:import:apply": "node --env-file=.env.local scripts/import-ventes-jour-excel.mjs --apply",
    "resync:sold": "node --env-file=.env.local scripts/resync-sold-depuis-ventes-log.mjs",
    "resync:sold:apply": "node --env-file=.env.local scripts/resync-sold-depuis-ventes-log.mjs --apply",
    "gmail:oauth": "node --env-file=.env.local scripts/gmail-oauth-setup.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@zxing/browser": "^0.2.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "googleapis": "^178.0.0",
    "jose": "^6.2.8",
    "mongodb": "^7.5.0",
    "next": "16.3.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
